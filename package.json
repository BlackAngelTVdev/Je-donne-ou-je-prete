"scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "build-img-l": "mkdir -p build/public/uploads/items && mkdir -p ./items_backup && cp -r build/public/uploads/items/. ./items_backup/ && node ace build && mkdir -p build/public/uploads/items && cp -r ./items_backup/. build/public/uploads/items/ && rm -rf ./items_backup",
    "build-img-w": "npx shx mkdir -p build/public/uploads/items && npx shx mkdir -p ./items_backup && npx shx cp -r build/public/uploads/items/* ./items_backup/ && node ace build && npx shx mkdir -p build/public/uploads/items && npx shx cp -r ./items_backup/* build/public/uploads/items/ && npx shx rm -rf ./items_backup",
    "dev": "node ace serve --watch --no-clear",
    "test": "node ace test --no-assets",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/http-server": "^7.8.0",
    "@adonisjs/prettier-config": "^1.4.4",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.0.4",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "1.11.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "eslint": "^9.26.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "shx": "^0.4.0",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.8",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.5.1",
    "@adonisjs/bouncer": "^3.1.6",
    "@adonisjs/core": "^6.19.1",
    "@adonisjs/hash": "^9.1.1",
    "@adonisjs/i18n": "^2.2.3",
    "@adonisjs/lucid": "^21.8.1",
    "@adonisjs/mail": "^9.2.0",
    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@vinejs/vine": "^3.0.1",
    "auth": "^1.0.2",
    "better-sqlite3": "^12.10.0",
    "bootstrap": "^5.3.8",
    "edge.js": "^6.2.1",
    "edu-sso-bridge": "^1.0.4",
    "luxon": "^3.7.2",
    "mysql2": "^3.15.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "main": "ace.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "description": ""
}

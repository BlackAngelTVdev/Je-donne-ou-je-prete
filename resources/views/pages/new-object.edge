    {{-- Type (Don/Prêt/Recherche) --}}
    <div class="field-group">
      <label for="mode">{{ t('messages.add_item.mode_label') }}</label>
      <select id="mode" name="mode" required>
        <option value="">
          {{ t('messages.add_item.mode_select') }}
        </option>
        <option value="donation" {{ old('mode')=='donation' ? 'selected' : '' }}>
          {{ t('messages.add_item.mode_donation') }}
        </option>
        <option value="search" {{ old('mode')=='search' ? 'selected' : '' }}>
          {{ t('messages.add_item.mode_search') }}
        </option>
      </select>
    </div>

    {{-- Type (Don/Prêt) - Visible uniquement en mode donation --}}
    <div id="type_section" class="field-group" style="display: none;">
      <label for="type">{{ t('messages.add_item.status_label') }}</label>
      <select id="type" name="type">
        <option value="">
          {{ t('messages.add_item.status_select') }}
        </option>
        <option value="0" {{ old('type')=='0' ? 'selected' : '' }}>
          {{ t('messages.add_item.status_give') }}
        </option>
        <option value="1" {{ old('type')=='1' ? 'selected' : '' }}>
          {{ t('messages.add_item.status_lend') }}
        </option>
      </select>
    </div>

    {{-- Section Dates --}}
    <div id="availability_section" class="field-group" style="display: none;">
      <p>
        {{ t('messages.add_item.loan_details') }}
      </p>

      {{-- Toujours visible si Don ou Prêt --}}
      <div class="field">
        <label for="available_from">{{ t('messages.add_item.from') }}</label>
        <input
          type="datetime-local"
          id="available_from"
          name="available_from"
          value="{{ old('available_from') || '' }}"
        />
      </div>

      {{-- Masqué si c'est un Don --}}
      <div id="until_field">
        <div class="field">
          <label for="available_until">{{ t('messages.add_item.until') }}</label>
          <input
            type="datetime-local"
            id="available_until"
            name="available_until"
            value="{{ old('available_until') || '' }}"
          />
        </div>
      </div>
    </div>

    <div class="actions">
      <button type="submit">
        {{ t('messages.add_item.submit') }}
      </button>
      {{-- Lien retour vers Home via route() --}}
      <a href="{{ route('donation_objects.index') }}" class="btn-cancel">{{ t('messages.add_item.back') }}</a>
    </div>
  </form>
</main>

<script>
  const modeSelector = document.getElementById("mode");

  const typeSection = document.getElementById("type_section");

  const typeSelector = document.getElementById("type");

  const availabilitySection = document.getElementById("availability_section");

  const untilField = document.getElementById("until_field");

  const objectForm = document.getElementById("objectForm");

  const hiddenMode = document.getElementById("hiddenMode");
  // AJOUTE CES DEUX LIGNES ICI :

  const imageSelector = document.getElementById("image");

  const imageDisplay = document.getElementById("imageDisplay");

  function toggleMode() {
    const mode = modeSelector.value;
    hiddenMode.value = mode;
    if (mode === "donation") {
      typeSection.style.display = "block";
      // Déclenche aussi la fonction toggleDates
      toggleDates();
    } else if (mode === "search") {
      typeSection.style.display = "none";
      typeSelector.value = "";
      availabilitySection.style.display = "block";
    } else {
      typeSection.style.display = "none";
      availabilitySection.style.display = "none";
    }
  }

  function toggleDates() {
    const val = typeSelector.value;
    if (val === "0") {
      availabilitySection.style.display = "block";
      untilField.style.display = "block";
    } else if (val === "1") {
      availabilitySection.style.display = "block";
      untilField.style.display = "block";
    } else {
      availabilitySection.style.display = "none";
    }
  }
  // Intercepter le submit pour rediriger vers la bonne route

  objectForm.addEventListener("submit", function(e) {
    const mode = modeSelector.value;
    if (mode === "search") {
      // Changer l'action vers cherche_objects.store
      objectForm.action = "{{ route("cherche_objects.store") }}";
    } else {
      objectForm.action = "{{ route("donation_objects.store") }}";
    }
  });

  modeSelector.addEventListener("change", toggleMode);

  typeSelector.addEventListener("change", toggleDates);

  window.addEventListener("DOMContentLoaded", function() {
    toggleMode();
  });
  // CETTE PARTIE FONCTIONNERA MAINTENANT :

  imageSelector.addEventListener("change", function(event) {
    if (event.target.files && event.target.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        imageDisplay.src = e.target.result;
        imageDisplay.classList.remove("CACHER"); // Enlève la classe qui cache
        imageDisplay.style.display = "block";
      };
      reader.readAsDataURL(event.target.files[0]);
    }
  });
</script>

@include('partials/footer')

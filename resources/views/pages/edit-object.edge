@let(css = 'object-form.css')
@include('partials/header')

@let(catMap = {
  'Sport & Loisirs': 'sport',
  'Culture & Livres': 'books',
  'Vêtements': 'clothes',
  'Informatique & Tech': 'tech',
  'Maison & Cuisine': 'home',
  'Jouets & Enfants': 'toys',
  'Électroménager': 'appliances',
  'Musique & Art': 'art',
  'Bureau & Fournitures': 'office'
})

{{-- Déterminer si c'est un objet donation ou cherche --}}
@let(isDonation = object.type !== undefined)
@let(isCherche = !isDonation)

<main>
  @include('partials/flash')
  <h1>
    {{ t('messages.edit_item.title') }}  {{ object.name }}
  </h1>

  {{-- La route update avec l'ID de l'objet --}}
  @if(isDonation)
    <form
      id="editForm"
      action="{{ route('donation_objects.update', { id: object.id }) }}"
      method="POST"
      enctype="multipart/form-data"
    >
    @else
      <form
        id="editForm"
        action="{{ route('cherche_objects.update', { id: object.id }) }}"
        method="POST"
        enctype="multipart/form-data"
      >
      @endif
      {{ csrfField() }}
      {{-- Pour Adonis, on utilise l'ID de route POST sans _method --}}
      <!-- Champ _method supprimé, tout passe en POST -->

      {{-- Section Image --}}
      <div class="field-group">
        @!component('components/input', {
        name : 'image',
        label : t('messages.edit_item.image_placeholder'),
        type : 'file',
        attributes: { id: 'image' }
        })
        @if(object.imagePath)
          <img id="imageDisplay" src="/uploads/items/{{ object.imagePath }}" alt="{{ t('messages.add_item.image_preview_alt') }}" />
        @else
          <img class="CACHER" id="imageDisplay" src="" alt="{{ t('messages.add_item.image_preview_alt') }}" />
        @endif
      </div>

      {{-- Nom --}}
      <div class="field-group">
        <label for="name">{{ t('messages.add_item.name_label') }}</label>
        <input id="name" type="text" name="name" value="{{ old('name') || object.name }}" required />
        @if(flashMessages.has('errors.name'))
          <p class="errors">
            {{ flashMessages.get('errors.name') }}
          </p>
        @endif
      </div>

      {{-- Description --}}
      <div class="field-group">
        <label for="description">{{ t('messages.add_item.desc_label') }}</label>
        <textarea id="description" name="description" rows="5" required>{{ old('description') || object.description }}</textarea>
        @if(flashMessages.has('errors.description'))
          <p class="errors">
            {{ flashMessages.get('errors.description') }}
          </p>
        @endif
      </div>

      <div class="field-group">
        <label for="IsUrgent">{{ t('messages.add_item.urgent_label') }}</label>
        <input type="hidden" name="IsUrgent" value="0" />
        <input type="checkbox" id="IsUrgent" name="IsUrgent" value="1" {{ object.urgent ? 'checked' : '' }} />
      </div>

      {{-- Catégorie --}}
      <div class="field-group">
        <label for="categorie">{{ t('messages.add_item.cat_label') }}</label>
        <select name="categorie" id="categorie" required>
          <option value="" disabled {{ !old('categorie') ? 'selected' : '' }}>
            {{ t('messages.add_item.cat_select') }}
          </option>

          {{-- Liste simple des clés techniques --}}
          @each(key in ['sport', 'books', 'clothes', 'tech', 'home', 'toys', 'appliances', 'art', 'office'])
            <option value="{{ key }}" {{ (old('categorie')===key || object.categorie === key) ? 'selected' : '' }}>
              {{ t(`messages.add_item.categories.${key}`) }}
            </option>
          @end
        </select>
      </div>

      {{-- Mode (Don/Prêt/Recherche) --}}
      <div class="field-group">
        <label for="mode">{{ t('messages.add_item.mode_label') }}</label>
        <select id="mode" name="mode" required>
          <option value="">
            {{ t('messages.add_item.mode_select') }}
          </option>
          <option value="donation" {{ (isDonation) ? 'selected' : '' }}>
            {{ t('messages.home.mode_donation') }}
          </option>
          <option value="search" {{ (isCherche) ? 'selected' : '' }}>
            {{ t('messages.home.mode_search') }}
          </option>
        </select>
      </div>

      {{-- Type (Don/Prêt) - Visible uniquement en mode donation --}}
      <div id="type_section" class="field-group" style="display: none;">
        <label for="type">{{ t('messages.add_item.status_label') }}</label>
        <select id="type" name="type">
          <option value="">
            {{ t('messages.add_item.status_select') }}
          </option>
          <option value="0" {{ (old('type') == '0' || (isDonation && object.type == false)) ? 'selected' : '' }}>
            {{ t('messages.add_item.status_give') }}
          </option>
          <option value="1" {{ (old('type') == '1' || (isDonation && object.type == true)) ? 'selected' : '' }}>
            {{ t('messages.add_item.status_lend') }}
          </option>
        </select>
      </div>

      {{-- Section Dates --}}
      <div id="availability_section" class="field-group" style="display: none;">
        <p>
          {{ t('messages.add_item.loan_details') }}
        </p>

        {{-- Toujours visible si Don ou Prêt --}}
        <div class="field">
          <label for="available_from">{{ t('messages.add_item.from') }}</label>
          @if(isDonation)
            <input
              type="datetime-local"
              id="available_from"
              name="available_from"
              value="{{ old('available_from') || (object.availableFrom ? object.availableFrom.toISO().slice(0, 16) : '') }}"
            />
          @else
            <input
              type="datetime-local"
              id="available_from"
              name="available_from"
              value="{{ old('available_from') || (object.neededFrom ? object.neededFrom.toISO().slice(0, 16) : '') }}"
            />
          @endif
        </div>

        {{-- Masqué si c'est un Don --}}
        <div id="until_field">
          <div class="field">
            <label for="available_until">{{ t('messages.add_item.until') }}</label>
            @if(isDonation)
              <input
                type="datetime-local"
                id="available_until"
                name="available_until"
                value="{{ old('available_until') || (object.availableUntil ? object.availableUntil.toISO().slice(0, 16) : '') }}"
              />
            @else
              <input
                type="datetime-local"
                id="available_until"
                name="available_until"
                value="{{ old('available_until') || (object.neededUntil ? object.neededUntil.toISO().slice(0, 16) : '') }}"
              />
            @endif
          </div>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="btn-save">{{ t('messages.edit_item.submit') }}</button>
        @if(isDonation)
          <a href="{{ route('donation_objects.show', { id: object.id }) }}" class="btn-cancel">
            {{ t('messages.edit_item.cancel') }}
        </a>
        @else
          <a href="{{ route('cherche_objects.show', { id: object.id }) }}" class="btn-cancel">
            {{ t('messages.edit_item.cancel') }}
        </a>
        @endif
      </div>
    </form>
  </main>

  <script>
    const modeSelector = document.getElementById("mode");

    const typeSection = document.getElementById("type_section");

    const typeSelector = document.getElementById("type");

    const availabilitySection = document.getElementById("availability_section");

    const untilField = document.getElementById("until_field");

    const imageSelector = document.getElementById("image");

    const imageDisplay = document.getElementById("imageDisplay");

    function updateDisplay() {
      const mode = modeSelector.value;
      const type = typeSelector.value;
      if (mode === "donation") {
        typeSection.style.display = "block";
        typeSelector.disabled = false;
        if (type === "0") {
          // Don
          availabilitySection.style.display = "block";
          untilField.style.display = "block";
        } else if (type === "1") {
          // Prêt
          availabilitySection.style.display = "block";
          untilField.style.display = "block";
        } else {
          availabilitySection.style.display = "none";
        }
      } else if (mode === "search") {
        typeSection.style.display = "none";
        typeSelector.disabled = true;
        // En mode recherche, on a généralement besoin des deux dates (début/fin du besoin)
        availabilitySection.style.display = "block";
        untilField.style.display = "block";
      } else {
        typeSection.style.display = "none";
        availabilitySection.style.display = "none";
      }
    }

    modeSelector.addEventListener("change", updateDisplay);

    typeSelector.addEventListener("change", updateDisplay);
    // Initialisation au chargement

    window.addEventListener("DOMContentLoaded", updateDisplay);
    // Aperçu de l'image

    imageSelector.addEventListener("change", function(event) {
      if (event.target.files && event.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          imageDisplay.src = e.target.result;
          imageDisplay.classList.remove("CACHER");
          imageDisplay.style.display = "block";
        };
        reader.readAsDataURL(event.target.files[0]);
      }
    });
  </script>

  @include('partials/footer')
